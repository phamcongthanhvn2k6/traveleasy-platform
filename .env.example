# ==============================================================================
# HẠ TẦNG CƠ SỞ DỮ LIỆU MYSQL (DOCKER / LOCAL)
# ==============================================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=traveleasy_db
MYSQL_USER=traveleasy_user
MYSQL_PASSWORD=traveleasy_password
MYSQL_ROOT_PASSWORD=root_password_2026

# ==============================================================================
# THÔNG SỐ BACKEND SPRING BOOT
# ==============================================================================
SERVER_PORT=8080
JWT_SECRET=TravelEasyDevSecretKeyForLocalDevelopmentOnlyDoNotUseInProduction2026
JWT_EXPIRATION_MS=86400000

# ==============================================================================
# CẤU HÌNH SPRING AI (OPENAI / GEMINI / MOCK)
# ==============================================================================
SPRING_AI_OPENAI_API_KEY=your_openai_api_key_here_or_mock_key

# ==============================================================================
# HẠ TẦNG OBSERVABILITY (PROMETHEUS, GRAFANA, TEMPO, LOKI)
# ==============================================================================
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123@
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
