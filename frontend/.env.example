# ==================== FIREBASE (Frontend) ====================
# Lấy từ Firebase Console > Project settings > General > Your apps > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Explicitly true ONLY for Firebase Console test phone numbers; leave false/empty for real SMS.
VITE_FIREBASE_AUTH_TEST_MODE=false

# ==================== BACKEND ====================
# Đường dẫn tới tệp Service Account JSON của Firebase
# (Firebase Console > Project settings > Service accounts > Generate new private key)
FIREBASE_CREDENTIALS_PATH=
